{
  "openapi": "3.1.0",
  "info": {
    "title": "Climate-Ledger Carbon Accounting & Credit Readiness API",
    "version": "2.0.0",
    "description": "High-precision, audit-grade carbon accounting & registry crediting API. Supports gross inventory (Households, IPCC Tier 1 Agriculture, Corporate Scopes 1-3, GSF SCI) and statutory carbon credit issuance (Verra VM0042, Gold Standard LUF, CDM ACM0002, India BEE CCTS). Validated for programmatic AI agent integration, LLM tool-calling, and enterprise ESG reporting.",
    "contact": {
      "name": "Climate-Ledger Engineering",
      "url": "https://carbonfootprintcalculator-two.vercel.app"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://carbonfootprintcalculator-two.vercel.app",
      "description": "Production Server (Vercel Edge)"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/api/calculate": {
      "get": {
        "summary": "Calculate carbon footprint or registry credit issuance (GET Query)",
        "operationId": "calculateCarbonFootprintGet",
        "description": "Calculates audit-grade carbon emissions (tCO2e and kgCO2e), emission breakdowns by scope, and statutory carbon credit issuance (BE - PE - LE - Buffer) via URL query parameters.",
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "description": "Optional crediting suite archetype mode: household (retirement), farmer (Verra VM0042), clean_energy (ACM0002), or obligated_industry (India BEE CCTS)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["household", "farmer", "clean_energy", "obligated_industry"]
            }
          },
          {
            "name": "role",
            "in": "query",
            "description": "Inventory archetype selector",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["individual", "household", "farmer", "agriculture", "company", "corporate"],
              "default": "individual"
            }
          },
          {
            "name": "grid",
            "in": "query",
            "description": "Regional electricity grid emission factor preset (India CEA: 0.716, US eGRID: 0.386, EU AIB: 0.255, UK DESNZ: 0.207)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["india_cea", "us_egrid", "eu_residual", "uk_desnz"],
              "default": "india_cea"
            }
          },
          {
            "name": "kwh",
            "in": "query",
            "description": "Monthly electricity consumption in kilowatt-hours (kWh)",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 0 }
          },
          {
            "name": "waterM3",
            "in": "query",
            "description": "Monthly domestic water consumption in cubic meters (m³)",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 0 }
          },
          {
            "name": "hasSewage",
            "in": "query",
            "description": "Whether domestic water has municipal sewage treatment",
            "required": false,
            "schema": { "type": "boolean", "default": true }
          },
          {
            "name": "wasteKg",
            "in": "query",
            "description": "Weekly municipal solid waste generation in kilograms (kg)",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 0 }
          },
          {
            "name": "wasteRoute",
            "in": "query",
            "description": "Disposal pathway for solid waste",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["landfill", "compost", "recycling"],
              "default": "landfill"
            }
          },
          {
            "name": "lpgKg",
            "in": "query",
            "description": "Monthly LPG cooking gas consumption in kg (factor: 2.983 kg CO2e/kg)",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 0 }
          },
          {
            "name": "petrolLiters",
            "in": "query",
            "description": "Monthly motor gasoline / petrol in liters (factor: 2.31 kg CO2e/L)",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 0 }
          },
          {
            "name": "dieselLiters",
            "in": "query",
            "description": "Monthly automotive diesel in liters (factor: 2.68 kg CO2e/L)",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 0 }
          },
          {
            "name": "farmAreaHa",
            "in": "query",
            "description": "Farmland area in hectares (ha) for Verra VM0042 crediting",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 25 }
          },
          {
            "name": "soilBulkDensity",
            "in": "query",
            "description": "Soil Bulk Density (g/cm³), default 1.30",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 1.30 }
          },
          {
            "name": "soilSamplingDepthM",
            "in": "query",
            "description": "Soil sampling depth in meters (m), default 0.30 m",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 0.30 }
          },
          {
            "name": "soilDeltaCarbonPct",
            "in": "query",
            "description": "Annual soil organic carbon change Delta %C, default 0.25",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 0.25 }
          },
          {
            "name": "soilCoarseRockFraction",
            "in": "query",
            "description": "Coarse rock volume fraction CF, default 0.05",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 0.05 }
          },
          {
            "name": "treeCount",
            "in": "query",
            "description": "Agroforestry tree count for allometric biomass calculation",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 1200 }
          },
          {
            "name": "treeDbhCm",
            "in": "query",
            "description": "Mean tree diameter at breast height (cm), default 18 cm",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 18 }
          },
          {
            "name": "treeHeightM",
            "in": "query",
            "description": "Mean tree height in meters (m), default 12 m",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 12 }
          },
          {
            "name": "treeWoodDensity",
            "in": "query",
            "description": "Mean wood specific density (g/cm³), default 0.55",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 0.55 }
          },
          {
            "name": "farmLeakagePct",
            "in": "query",
            "description": "Activity-shifting leakage deduction percentage, default 5.0%",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 5.0 }
          },
          {
            "name": "farmBufferPoolPct",
            "in": "query",
            "description": "Verra non-permanence risk buffer withholding percentage, default 15.0%",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 15.0 }
          },
          {
            "name": "cleanTech",
            "in": "query",
            "description": "Renewable technology type for CDM ACM0002 grid displacement",
            "required": false,
            "schema": { "type": "string", "enum": ["solar", "wind", "hydro", "biomass"], "default": "solar" }
          },
          {
            "name": "cleanExportMwh",
            "in": "query",
            "description": "Net clean electricity exported to the grid in MWh",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 5000 }
          },
          {
            "name": "cleanAuxiliaryPeTco2e",
            "in": "query",
            "description": "Auxiliary project emissions PE_aux in tCO2e",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 15.0 }
          },
          {
            "name": "cleanLeakageTco2e",
            "in": "query",
            "description": "Transmission leakage LE in tCO2e",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 0.0 }
          },
          {
            "name": "industrySector",
            "in": "query",
            "description": "Obligated sector for India BEE CCTS compliance",
            "required": false,
            "schema": { "type": "string", "default": "Iron & Steel (Crude Steel)" }
          },
          {
            "name": "indScope1Tco2e",
            "in": "query",
            "description": "Gate-to-gate Scope 1 direct combustion emissions in tCO2e",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 85000 }
          },
          {
            "name": "indScope2Tco2e",
            "in": "query",
            "description": "Gate-to-gate Scope 2 indirect electricity emissions in tCO2e",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 35000 }
          },
          {
            "name": "indProductionTonnes",
            "in": "query",
            "description": "Annual marketable production output in tonnes",
            "required": false,
            "schema": { "type": "number", "minimum": 1, "default": 75000 }
          },
          {
            "name": "indTargetGei",
            "in": "query",
            "description": "BEE statutory Target Greenhouse Gas Emission Intensity (tCO2e/tonne)",
            "required": false,
            "schema": { "type": "number", "minimum": 0, "default": 1.700 }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful calculation output",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CalculationResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid parameter input",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Calculate carbon footprint or registry credit issuance (POST JSON Body)",
        "operationId": "calculateCarbonFootprintPost",
        "description": "Calculates carbon emissions or statutory carbon credits with JSON body. Ideal for AI agent programmatic tool calling.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CalculationInput" },
              "example": {
                "mode": "farmer",
                "farmAreaHa": 25,
                "soilBulkDensity": 1.30,
                "soilSamplingDepthM": 0.30,
                "soilDeltaCarbonPct": 0.25,
                "soilCoarseRockFraction": 0.05,
                "treeCount": 1200,
                "treeDbhCm": 18,
                "treeHeightM": 12,
                "treeWoodDensity": 0.55,
                "farmMachineryDieselL": 1200,
                "farmSyntheticFertilizerKg": 1500,
                "farmLeakagePct": 5.0,
                "farmBufferPoolPct": 15.0
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful calculation output",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CalculationResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid JSON body payload",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
      }
    },
    "/api/retire-quote": {
      "post": {
        "summary": "Generate official carbon retirement quote & serialized certificate preview",
        "operationId": "generateRetireQuote",
        "description": "Calculates settlement cost, registry fees, and serialized certificate identifier for permanent non-tradable credit retirement on Verra, Gold Standard, or Carbonmark.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tco2e": { "type": "number", "minimum": 0.001, "default": 1.0 },
                  "projectId": { "type": "string", "enum": ["india_renewables", "verra_vm0042_soil", "gold_standard_cookstoves"], "default": "india_renewables" },
                  "beneficiaryName": { "type": "string", "default": "Verified Household" },
                  "retirementMessage": { "type": "string", "default": "Carbon Neutrality Commitment" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quote & Certificate Preview successfully generated"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CalculationInput": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["household", "farmer", "clean_energy", "obligated_industry"]
          },
          "role": {
            "type": "string",
            "enum": ["individual", "household", "farmer", "agriculture", "company", "corporate"],
            "default": "individual"
          },
          "grid": {
            "type": "string",
            "enum": ["india_cea", "us_egrid", "eu_residual", "uk_desnz"],
            "default": "india_cea"
          },
          "kwh": { "type": "number", "minimum": 0, "default": 0 },
          "waterM3": { "type": "number", "minimum": 0, "default": 0 },
          "lpgKg": { "type": "number", "minimum": 0, "default": 0 },
          "petrolLiters": { "type": "number", "minimum": 0, "default": 0 },
          "dieselLiters": { "type": "number", "minimum": 0, "default": 0 },
          "farmAreaHa": { "type": "number", "minimum": 0, "default": 25 },
          "soilBulkDensity": { "type": "number", "minimum": 0, "default": 1.30 },
          "soilSamplingDepthM": { "type": "number", "minimum": 0, "default": 0.30 },
          "soilDeltaCarbonPct": { "type": "number", "minimum": 0, "default": 0.25 },
          "soilCoarseRockFraction": { "type": "number", "minimum": 0, "default": 0.05 },
          "treeCount": { "type": "number", "minimum": 0, "default": 1200 },
          "treeDbhCm": { "type": "number", "minimum": 0, "default": 18 },
          "treeHeightM": { "type": "number", "minimum": 0, "default": 12 },
          "treeWoodDensity": { "type": "number", "minimum": 0, "default": 0.55 },
          "cleanTech": { "type": "string", "enum": ["solar", "wind", "hydro", "biomass"], "default": "solar" },
          "cleanExportMwh": { "type": "number", "minimum": 0, "default": 5000 },
          "cleanAuxiliaryPeTco2e": { "type": "number", "minimum": 0, "default": 15.0 },
          "industrySector": { "type": "string", "default": "Iron & Steel (Crude Steel)" },
          "indScope1Tco2e": { "type": "number", "minimum": 0, "default": 85000 },
          "indScope2Tco2e": { "type": "number", "minimum": 0, "default": 35000 },
          "indProductionTonnes": { "type": "number", "minimum": 1, "default": 75000 },
          "indTargetGei": { "type": "number", "minimum": 0, "default": 1.700 }
        }
      },
      "CalculationResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "mode": { "type": "string" },
          "governing_standard": { "type": "string" },
          "crediting_equation": { "type": "string" },
          "total_tco2e": { "type": "number" },
          "total_kg_co2e": { "type": "number" },
          "net_credits_tco2e": { "type": "number" },
          "credits_needed": { "type": "integer" },
          "gross_baseline_tco2e": { "type": "number" },
          "project_emissions_tco2e": { "type": "number" },
          "leakage_tco2e": { "type": "number" },
          "buffer_pool_tco2e": { "type": "number" },
          "recommended_registry": { "type": "string" },
          "registry_links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "url": { "type": "string" }
              }
            }
          },
          "breakdown": { "type": "object" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "error" },
          "message": { "type": "string" },
          "errors": { "type": "array" }
        }
      }
    }
  }
}
